// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model energy_logs {
  id        BigInt   @id @default(autoincrement())
  device_id Int
  current_a Decimal?
  voltage_v Decimal?
  power_w   Decimal
  created_at DateTime @default(now())
}
