generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model energy_logs {
  id         Int      @id @default(autoincrement())
  device_id  Int
  current_a  Decimal? @db.Decimal(10, 3) // 10 ta raqam, ulardan 3 tasi nuqtadan keyin
  voltage_v  Decimal? @db.Decimal(10, 3)
  power_w    Decimal  @db.Decimal(10, 3)
  created_at DateTime @default(now())
}

model energy_logs_by_hour {
  hour       DateTime
  device_id  Int
  energy_kwh Decimal  @db.Decimal(12, 3)

  @@id([hour, device_id])
}

model energy_logs_by_day {
  day        DateTime
  device_id  Int
  energy_kwh Decimal  @db.Decimal(14, 3)

  @@id([day, device_id])
}
